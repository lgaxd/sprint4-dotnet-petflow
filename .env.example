# PetFlow API (.NET) — modelo de variáveis de ambiente.
# Copie para ".env" (cp .env.example .env) e preencha com os seus valores. O ".env" NÃO deve ser versionado.
# Convenção .NET: "__" separa seções da configuração (Jwt__Key  ->  Jwt:Key no appsettings.json).
# Variáveis já definidas no ambiente do sistema têm prioridade sobre as deste arquivo.

# ── Oracle (EF Core) ─────────────────────────────────────────────────────────────
# Conexão por SID. Para service name, troque (SID=ORCL) por (SERVICE_NAME=nome_do_servico).
ConnectionStrings__OracleConnection=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521))(CONNECT_DATA=(SID=ORCL)));User Id=SEU_RM;Password=SUA_SENHA;

# ── JWT ──────────────────────────────────────────────────────────────────────────
# Chave com no mínimo 32 caracteres. Gere uma com:  openssl rand -hex 32
Jwt__Key=troque-por-uma-chave-secreta-com-no-minimo-32-caracteres
Jwt__ExpirationMinutes=60

# ── MongoDB (anotações dos pets) ─────────────────────────────────────────────────
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__Database=petflow

# ── CORS (origens separadas por vírgula; vazio = CORS desativado) ────────────────
Cors__AllowedOrigins=http://localhost:5173

# ── Docker (modo FIAP) ───────────────────────────────────────────────────────────
# Opcional: MongoDB que a API em contêiner deve usar. Padrão: mongodb://mongo:27017 (./start.sh --with-mongo).
# Ex.: Atlas ou um Mongo da sua máquina -> mongodb://host.docker.internal:27017
# FIAP_MONGO_CONNECTION=

# ── Migrations ───────────────────────────────────────────────────────────────────
# true = aplica as migrations do EF Core ao iniciar. Mantenha false se o schema veio do script SQL.
Database__ApplyMigrationsOnStartup=false
